#!/usr/bin/env bash
# =============================================================================
# pre-push — run the four boundary checks before anything leaves the machine.
#
# Enabled by ./scripts/install-hooks.sh, which points core.hooksPath at this
# directory so the hook is versioned with the repository instead of copied into
# .git/hooks where nobody can review it.
#
# Bypass with `git push --no-verify`. That it is possible is fine; that it has
# to be typed is the point.
# =============================================================================
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v python3 >/dev/null 2>&1; then
  printf 'pre-push: python3 not found, skipping boundary checks.\n' >&2
  exit 0
fi

printf 'pre-push: architecture boundaries (D24)...\n'
python3 tools/arch/run.py --no-colour
python3 -m unittest discover -s tools/arch/tests -t . 2>&1 | tail -3

printf 'pre-push: contract, pure zone...\n'
python3 tools/pure/run.py 2>&1 | tail -3
python3 tools/dsl/emit_schema.py >/dev/null
python3 ai/corpus/verifica_contratto.py 2>&1 | tail -2
python3 ai/corpus/misura_catalogo.py 2>&1 | tail -2
