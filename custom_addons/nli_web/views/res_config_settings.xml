<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.aida</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AIDA" string="AIDA" name="nli_web"
                     groups="base.group_system">

                    <block title="Modello con cui AIDA parla"
                           name="aida_model_block">

                        <setting string="Dove sta il modello"
                                 help="AIDA parla con un modello che espone il protocollo OpenAI. L'indirizzo e' quello che il server Odoo riesce a raggiungere: da dentro un contenitore, `localhost` e' il contenitore stesso.">
                            <field name="aida_endpoint" placeholder="http://host.docker.internal:11434/v1"/>
                            <div class="mt-2">
                                <field name="aida_model_name" placeholder="qwen3.5:9b"
                                       class="o_light_label"/>
                            </div>
                        </setting>

                        <setting string="Che cosa il modello sa fare"
                                 help="Sono le capacita' dichiarate del profilo (D78). Dichiararle sbagliate non rende il modello piu' capace: rende sbagliato il budget che se ne ricava.">
                            <field name="aida_context_window"/>
                            <div class="mt-2">
                                <field name="aida_constrained_generation"/>
                                <span class="ms-2">Sa rispettare uno schema JSON imposto</span>
                            </div>
                            <div class="mt-2">
                                <label for="aida_reasoning_effort" class="o_light_label"/>
                                <field name="aida_reasoning_effort"/>
                            </div>
                        </setting>

                    </block>

                    <block title="Messa in servizio" name="aida_state_block"
                           help="Un modello si configura qui, ma non entra in servizio da qui.">

                        <setting string="Stato del profilo"
                                 help="Un profilo nasce in bozza. Diventa qualificato quando qualcuno dichiara di aver eseguito le otto verifiche di D51, fra cui la prova di isolamento, e solo allora puo' essere attivato. D80 rifiuta l'attivazione di un profilo mai qualificato: e' una regola strutturale, non un promemoria, perche' un modello non verificato puo' rallentare l'ERP per tutti e non solo per chi lo ha scelto.">
                            <field name="aida_profile_state" widget="badge"/>
                            <div class="mt-2" invisible="not aida_profile_id">
                                <button name="action_aida_qualify" type="object"
                                        string="Dichiara eseguita la qualificazione"
                                        class="btn-link" icon="oi-arrow-right"
                                        invisible="aida_profile_state not in ['draft', 'retired']"/>
                                <button name="action_aida_activate" type="object"
                                        string="Metti in servizio questo modello"
                                        class="btn-link" icon="oi-arrow-right"
                                        invisible="aida_profile_state != 'qualified'"/>
                            </div>
                            <div class="mt-2 text-muted" invisible="aida_profile_id">
                                Nessun profilo ancora: compila l'indirizzo e il nome del modello e salva.
                            </div>
                        </setting>

                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
