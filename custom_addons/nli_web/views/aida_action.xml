<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      L'azione client che monta la chat. Non e' una vista su un modello: la
      conversazione non e' un elenco di record da sfogliare, e forzarla in una vista
      lista avrebbe dato all'utente un'interfaccia che gli chiede di capire il modello
      dei dati prima di poter fare una domanda.
    -->
    <!--
      `current` e non `fullscreen`: l'azione vive **dentro** la struttura di Odoo, con
      la barra di navigazione sempre visibile sopra. AIDA e' un modulo, non
      un'applicazione a parte, e l'utente deve poterne uscire come esce da qualunque
      altra schermata.

      Il campo si scrive per esteso invece di ometterlo: omettendolo, un aggiornamento
      del modulo **non tocca** il record gia' esistente — Odoo scrive solo i campi che
      trova — e un database che era passato da `fullscreen` resterebbe li' senza che
      nessuno se ne accorga.
    -->
    <record id="action_aida_chat" model="ir.actions.client">
        <field name="name">AIDA</field>
        <field name="tag">nli_web.chat</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_aida_root"
              name="AIDA"
              sequence="15"/>

    <menuitem id="menu_aida_chat"
              name="Fai una domanda"
              parent="menu_aida_root"
              action="action_aida_chat"
              sequence="10"/>

</odoo>
