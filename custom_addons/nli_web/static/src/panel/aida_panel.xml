<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!--
  Il pannello esiste nel DOM solo quando è aperto.

  Tenerlo montato e nasconderlo con `display: none` costerebbe, a ogni utente e per
  tutta la sessione, il disegno di una conversazione che nessuno guarda — e con lei
  la vista lista incorporata di ogni risposta, che è la parte cara. Un `t-if` sulla
  radice è ciò che rende AIDA gratuita per chi non la apre.
-->
<t t-name="nli_web.AidaPanel">
    <aside class="o_aida_scope o_aida_panel"
           t-if="ui.open"
           t-ref="panel"
           role="complementary"
           aria-label="AIDA — assistente conversazionale">

        <!--
          La maniglia è un `separator` con i suoi valori: un lettore di schermo
          annuncia «separatore, 440, minimo 360, massimo 960» e le frecce lo muovono.
          `tabindex` perché senza il fuoco non ci arriva, e senza fuoco le frecce non
          servono a niente.
        -->
        <div class="o_aida_resizer"
             role="separator"
             aria-orientation="vertical"
             aria-label="Larghezza del pannello"
             t-att-aria-valuenow="ui.width"
             tabindex="0"
             t-on-pointerdown="onResizeStart"
             t-on-pointermove="onResizeMove"
             t-on-pointerup="onResizeEnd"
             t-on-pointercancel="onResizeEnd"
             t-on-keydown="onResizeKeydown"/>

        <header class="o_aida_head">
            <button class="o_aida_icon"
                    type="button"
                    t-att-aria-expanded="ui.historyOpen"
                    aria-label="Mostra le conversazioni"
                    title="Conversazioni"
                    t-on-click="() => this.toggleHistory()">
                <i class="fa fa-bars" aria-hidden="true"/>
            </button>

            <span class="o_aida_mark" aria-hidden="true"/>
            <span class="o_aida_head_title">AIDA</span>
            <span class="o_aida_head_sub"
                  t-if="conversation and conversation.title"
                  t-esc="conversation.title"/>

            <span class="o_aida_head_spacer"/>

            <button class="o_aida_icon"
                    type="button"
                    aria-label="Nuova conversazione"
                    title="Nuova conversazione"
                    t-on-click="() => this.newConversation()">
                <i class="fa fa-pencil-square-o" aria-hidden="true"/>
            </button>
            <button class="o_aida_icon"
                    type="button"
                    aria-label="Chiudi AIDA"
                    title="Chiudi (Esc)"
                    t-on-click="() => this.aida.close()">
                <i class="fa fa-times" aria-hidden="true"/>
            </button>
        </header>

        <div class="o_aida_body">
            <t t-if="isEmpty">
                <AidaWelcome store="aida.store" state="state"/>
            </t>
            <t t-else="">
                <AidaThread store="aida.store" state="state"/>
            </t>

            <AidaHistory t-if="ui.historyOpen"
                         store="aida.store"
                         state="state"
                         onOpen="(id) => this.openConversation(id)"
                         onClose="() => this.toggleHistory()"/>
        </div>

        <footer class="o_aida_foot">
            <AidaComposer store="aida.store" state="state" busy="isBusy"/>
            <p class="o_aida_disclaimer">
                AIDA può sbagliare: sotto ogni risposta trovi come ha letto la domanda.
            </p>
        </footer>
    </aside>
</t>

<t t-name="nli_web.AidaLauncher">
    <!--
      `o_aida_scope` anche qui: i token vivono in quella classe, e senza il pulsante
      resterebbe fuori da tutte le regole che li leggono.

      **Niente classe `btn`.** C'era, e imponeva il colore di testo di Bootstrap: sulla
      barra scura di Odoo il risultato era grigio scuro su viola, illeggibile in tutti
      e tre i temi. La barra decide il proprio colore di primo piano, e il pulsante
      deve ereditarlo invece di sceglierne uno.
    -->
    <div class="o_aida_launcher o_aida_scope">
        <button class="o_aida_launch_btn"
                type="button"
                t-att-class="{ 'o_aida_launch_active': ui.open }"
                t-att-aria-pressed="ui.open"
                aria-label="Chiedi ad AIDA"
                t-att-title="'Chiedi ad AIDA (' + shortcut + ')'"
                t-on-click="() => this.aida.toggle()">
            <span class="o_aida_mark" aria-hidden="true"/>
            <span class="o_aida_launch_label">Chiedi ad AIDA</span>
            <!--
              Il puntino dice «sto ancora lavorando» a chi ha chiuso il pannello.
              Non è decorazione: senza, chiudere il pannello mentre AIDA pensa
              equivale a non sapere più se c'è una risposta che sta arrivando.
            -->
            <span class="o_aida_launch_dot" t-if="working" aria-hidden="true"/>
        </button>
        <span class="o_aida_sr" role="status" t-if="working">AIDA sta elaborando una risposta.</span>
    </div>
</t>

</templates>
