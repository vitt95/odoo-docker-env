<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="nli_web.AidaWelcome">
    <div class="o_aida_welcome">
        <span class="o_aida_mark o_aida_mark_lg" aria-hidden="true"/>
        <h1 class="o_aida_welcome_title">Che cosa vuoi sapere?</h1>
        <p class="o_aida_welcome_hint">
            Chiedi in italiano quello che cerchi nei tuoi dati.
        </p>

        <ul class="o_aida_suggestions">
            <t t-foreach="suggerimenti" t-as="esempio" t-key="esempio">
                <li>
                    <button class="o_aida_suggestion" type="button"
                            t-on-click="() => this.use(esempio)">
                        <i class="fa fa-comment-o" aria-hidden="true"/>
                        <span t-esc="esempio"/>
                    </button>
                </li>
            </t>
        </ul>
    </div>
</t>

<t t-name="nli_web.AidaHistory">
    <!--
      Il velo chiude cliccando fuori. È un `div` e non un bottone perché non è un
      comando: `Escape` e la freccia in alto fanno la stessa cosa e sono raggiungibili
      da tastiera, quindi qui non manca niente a nessuno.
    -->
    <div class="o_aida_history_veil" t-on-click="() => this.props.onClose()"/>

    <aside class="o_aida_history" aria-label="Conversazioni">
        <header class="o_aida_history_head">
            <span class="o_aida_history_title">Conversazioni</span>
            <button class="o_aida_icon" type="button"
                    aria-label="Chiudi le conversazioni"
                    t-on-click="() => this.props.onClose()">
                <i class="fa fa-times" aria-hidden="true"/>
            </button>
        </header>

        <nav class="o_aida_list" t-on-scroll="onScroll">
            <p class="o_aida_empty_hint"
               t-if="!props.state.conversations.length and !props.state.loadingConversations">
                Non hai ancora nessuna conversazione.
            </p>

            <t t-foreach="props.state.conversations" t-as="c" t-key="c.id">
                <div class="o_aida_item"
                     t-att-class="{ 'o_aida_item_active': c.id === props.state.currentId }">
                    <t t-if="ui.renamingId === c.id">
                        <input type="text" class="o_aida_rename"
                               t-model="ui.draftTitle"
                               t-on-keydown="onRenameKeydown"
                               t-on-blur="() => this.confirmRename()"
                               aria-label="Nuovo nome della conversazione"
                               autofocus="autofocus"/>
                    </t>
                    <t t-else="">
                        <button class="o_aida_item_open" type="button"
                                t-on-click="() => this.props.onOpen(c.id)"
                                t-att-aria-current="c.id === props.state.currentId ? 'true' : undefined">
                            <span class="o_aida_item_title"
                                  t-esc="c.title || 'Conversazione senza titolo'"/>
                        </button>
                        <!--
                          Le azioni compaiono al passaggio del mouse, ma restano
                          raggiungibili da tastiera: nasconderle con `display: none`
                          le toglierebbe anche al `Tab`.
                        -->
                        <div class="o_aida_item_actions">
                            <button class="o_aida_icon" type="button"
                                    title="Rinomina conversazione"
                                    aria-label="Rinomina conversazione"
                                    t-on-click="() => this.startRename(c)">
                                <i class="fa fa-pencil" aria-hidden="true"/>
                            </button>
                            <button class="o_aida_icon" type="button"
                                    title="Elimina conversazione"
                                    aria-label="Elimina conversazione"
                                    t-on-click="() => this.remove(c)">
                                <i class="fa fa-trash" aria-hidden="true"/>
                            </button>
                        </div>
                    </t>
                </div>
            </t>

            <p class="o_aida_loading" t-if="props.state.loadingConversations">Carico…</p>
        </nav>
    </aside>
</t>

<t t-name="nli_web.AidaComposer">
    <div class="o_aida_composer" t-att-class="{ 'o_aida_composer_busy': props.busy }">
        <textarea class="o_aida_input"
                  t-ref="input"
                  rows="1"
                  t-att-placeholder="placeholder"
                  t-att-value="text"
                  t-on-input="onInput"
                  t-on-keydown="onKeydown"
                  aria-label="Scrivi la tua domanda"/>
        <div class="o_aida_composer_bar">
            <!--
              Il conteggio compare solo vicino al limite. Un contatore sempre acceso
              insegna a contare invece che a scrivere, e nessuno ha bisogno di sapere
              che è a 40 caratteri su 2000.
            -->
            <span class="o_aida_counter" t-if="nearLimit" t-esc="counter"/>
            <span class="o_aida_composer_spacer"/>
            <button class="o_aida_send"
                    type="button"
                    t-att-disabled="!canSend"
                    t-att-aria-label="props.busy ? 'AIDA sta rispondendo' : 'Invia la domanda'"
                    t-att-title="props.busy ? 'AIDA sta rispondendo' : 'Invia (Invio)'"
                    t-on-click="() => this.send()">
                <i class="fa fa-arrow-up" aria-hidden="true"/>
            </button>
        </div>
    </div>
</t>

</templates>
