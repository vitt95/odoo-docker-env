<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="nli_web.AidaSteps">
    <div class="o_aida_steps">

        <!--
          L'intestazione ha due vite. Mentre il turno lavora è l'attesa: il segno che
          si deforma e il testo con la luce che scorre. A turno finito è il riassunto
          ripiegato, che si apre.

          `aria-live="polite"` sta qui e non sulle righe: chi usa un lettore di
          schermo deve sentire *che cosa sta facendo adesso*, non farsi rileggere
          l'elenco a ogni passo.
        -->
        <t t-if="!props.turn.stepsCollapsed">
            <p class="o_aida_thinking" aria-live="polite">
                <span class="o_aida_morph" aria-hidden="true"/>
                <span class="o_aida_shimmer" t-if="!props.turn.slow">Sto pensando…</span>
                <span class="o_aida_shimmer" t-else="">Ci sto ancora pensando…</span>
            </p>
        </t>
        <t t-else="">
            <button class="o_aida_steps_summary"
                    type="button"
                    t-att-aria-expanded="ui.expanded"
                    t-on-click="() => this.toggle()">
                <i class="fa fa-angle-right o_aida_caret" aria-hidden="true"/>
                <t t-esc="summary"/>
            </button>
        </t>

        <!--
          `t-key` sull'indice del server: la finestra scorre e OWL sposta le righe
          invece di ridisegnarle. Con la posizione nell'array le tre righe
          risulterebbero tutte cambiate a ogni passo.
        -->
        <ol class="o_aida_steps_list" t-if="visible.length">
            <li class="o_aida_step" t-foreach="visible" t-as="step" t-key="key(step)">
                <span class="o_aida_step_icon" aria-hidden="true">
                    <i t-att-class="icon(step)"/>
                </span>
                <span class="o_aida_step_body">
                    <span class="o_aida_step_label" t-esc="label(step)"/>
                    <span class="o_aida_step_detail" t-if="detail(step)" t-esc="detail(step)"/>
                </span>
            </li>
        </ol>

        <!--
          Quando la finestra nasconde qualcosa lo dice. Un elenco che tiene sempre
          tre righe senza spiegare perché fa credere che i passi siano stati tre.
        -->
        <p class="o_aida_steps_more" t-if="truncated">
            e <t t-esc="steps.length - visible.length"/> prima
        </p>
    </div>
</t>

</templates>
