<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Read everybody's rows, write only your own.

      The asymmetry is the whole reason the queue is a model of its own. L3 — queue
      depth — is evaluated at acceptance, with the identity of the user asking, and a
      depth counted over one's own rows is not a depth: it would coincide with L1 and
      the queue would have no limit at all.

      Reading is harmless here because there is nothing to read: a lane, a state, two
      timestamps and the utterance as ciphertext (D96). The question, its
      interpretation and its result live on `nli.turn`, behind the rule that already
      restricts them to their owner.

      Writing is restricted because it is not harmless: without this rule any
      internal user could expire a colleague's turn, which is a denial of service
      with no trace and no error.
    -->
    <record id="nli_queue_item_write_own" model="ir.rule">
        <field name="name">Queue items: write your own</field>
        <field name="model_id" ref="model_nli_queue_item"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
