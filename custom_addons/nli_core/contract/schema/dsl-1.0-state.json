{
  "$defs": {
    "condition": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "origin": {
          "enum": [
            "default",
            "inferred",
            "user"
          ]
        },
        "predicate": {
          "enum": [
            "after",
            "approximately",
            "before",
            "between",
            "contains",
            "equals",
            "greater_or_equal",
            "greater_than",
            "is_category",
            "is_empty",
            "is_false",
            "is_not_empty",
            "is_not_one_of",
            "is_not_set",
            "is_one_of",
            "is_set",
            "is_true",
            "less_or_equal",
            "less_than",
            "on",
            "starts_with",
            "within"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "required": [
        "id",
        "ref",
        "predicate",
        "origin"
      ],
      "type": "object"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "node": {
      "description": "A tree with closed connectives and a maximum depth of 3 (§5.4). The depth is checked at level 4: JSON Schema can express recursion but not a bound on it.",
      "oneOf": [
        {
          "$ref": "#/$defs/condition"
        },
        {
          "additionalProperties": false,
          "properties": {
            "conditions": {
              "items": {
                "$ref": "#/$defs/node"
              },
              "minItems": 1,
              "type": "array"
            },
            "connective": {
              "enum": [
                "all",
                "any",
                "not"
              ]
            }
          },
          "required": [
            "connective",
            "conditions"
          ],
          "type": "object"
        }
      ]
    },
    "provenance": {
      "additionalProperties": false,
      "description": "The fragment of the user's sentence that produced this element (§10.3). The fragment, never the message.",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "value": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "kind": {
              "const": "enum"
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "number"
            },
            "resolver": {
              "description": "Names a resolver defined in the Semantic Dictionary (§9.3). The model declares that the value is approximate and which rule applies; it never decides the tolerance.",
              "type": "string"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "number"
            },
            "kind": {
              "const": "range"
            },
            "to": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "from",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reference"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "date": {
              "type": "string"
            },
            "expression": {
              "enum": [
                "absolute",
                "absolute_range",
                "current_month",
                "current_quarter",
                "current_week",
                "current_year",
                "half_of_year",
                "last_n_days",
                "last_n_months",
                "last_n_weeks",
                "month_of_year",
                "next_n_days",
                "previous_month",
                "previous_quarter",
                "previous_week",
                "previous_year",
                "quarter_of_year",
                "today",
                "tomorrow",
                "year_of",
                "year_to_date",
                "yesterday"
              ]
            },
            "from": {
              "type": "string"
            },
            "kind": {
              "const": "temporal"
            },
            "n": {
              "minimum": 1,
              "type": "integer"
            },
            "to": {
              "type": "string"
            },
            "year": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "expression"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://aida.local/dsl/1.0/state.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The interrogation in semantic terms: persistable, shareable, and containing no Odoo model or field name (§5.10).",
  "properties": {
    "dsl_version": {
      "const": "1.0"
    },
    "fields": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "origin": {
            "enum": [
              "default",
              "inferred",
              "user"
            ]
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          },
          "rule": {
            "enum": [
              "default_list",
              "grouping_without_measure_implies_list",
              "latest_implies_desc_by_date",
              "measures_multi_group_implies_pivot",
              "measures_single_group_implies_graph",
              "measures_without_group_implies_list",
              "target_carried_from_previous_turn",
              "text_attribute_implies_asc"
            ]
          }
        },
        "required": [
          "ref",
          "origin"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "filter": {
      "$ref": "#/$defs/node"
    },
    "group_by": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "granularity": {
            "enum": [
              "day",
              "month",
              "quarter",
              "week",
              "year"
            ]
          },
          "origin": {
            "enum": [
              "default",
              "inferred",
              "user"
            ]
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          },
          "rule": {
            "enum": [
              "default_list",
              "grouping_without_measure_implies_list",
              "latest_implies_desc_by_date",
              "measures_multi_group_implies_pivot",
              "measures_single_group_implies_graph",
              "measures_without_group_implies_list",
              "target_carried_from_previous_turn",
              "text_attribute_implies_asc"
            ]
          }
        },
        "required": [
          "ref",
          "origin"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    },
    "limit": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "origin": {
          "enum": [
            "default",
            "inferred",
            "user"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "rule": {
          "enum": [
            "default_list",
            "grouping_without_measure_implies_list",
            "latest_implies_desc_by_date",
            "measures_multi_group_implies_pivot",
            "measures_single_group_implies_graph",
            "measures_without_group_implies_list",
            "target_carried_from_previous_turn",
            "text_attribute_implies_asc"
          ]
        },
        "value": {
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "value",
        "origin"
      ],
      "type": "object"
    },
    "measures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "function": {
            "enum": [
              "avg",
              "count",
              "count_distinct",
              "max",
              "min",
              "sum"
            ]
          },
          "origin": {
            "enum": [
              "default",
              "inferred",
              "user"
            ]
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          },
          "rule": {
            "enum": [
              "default_list",
              "grouping_without_measure_implies_list",
              "latest_implies_desc_by_date",
              "measures_multi_group_implies_pivot",
              "measures_single_group_implies_graph",
              "measures_without_group_implies_list",
              "target_carried_from_previous_turn",
              "text_attribute_implies_asc"
            ]
          }
        },
        "required": [
          "function",
          "origin"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "order_by": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "direction": {
            "enum": [
              "asc",
              "desc"
            ]
          },
          "origin": {
            "enum": [
              "default",
              "inferred",
              "user"
            ]
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          },
          "rule": {
            "enum": [
              "default_list",
              "grouping_without_measure_implies_list",
              "latest_implies_desc_by_date",
              "measures_multi_group_implies_pivot",
              "measures_single_group_implies_graph",
              "measures_without_group_implies_list",
              "target_carried_from_previous_turn",
              "text_attribute_implies_asc"
            ]
          }
        },
        "required": [
          "ref",
          "direction",
          "origin"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "presentation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "origin": {
          "enum": [
            "default",
            "inferred",
            "user"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "rule": {
          "enum": [
            "default_list",
            "grouping_without_measure_implies_list",
            "latest_implies_desc_by_date",
            "measures_multi_group_implies_pivot",
            "measures_single_group_implies_graph",
            "measures_without_group_implies_list",
            "target_carried_from_previous_turn",
            "text_attribute_implies_asc"
          ]
        },
        "view": {
          "enum": [
            "calendar",
            "form",
            "graph",
            "kanban",
            "list",
            "pivot"
