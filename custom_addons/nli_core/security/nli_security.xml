<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      A user sees their own interrogations and nobody else's.

      Not a convenience: an interrogation is a question somebody asked, and §5.10
      makes the state portable and shareable *by an explicit act*. Making them
      readable by default would share them by omission, which is the opposite.

      Sharing, when it arrives, adds a field and widens this rule in the same change.
    -->
    <record id="nli_interrogation_own" model="ir.rule">
        <field name="name">Interrogations: own only</field>
        <field name="model_id" ref="model_nli_interrogation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="nli_turn_own" model="ir.rule">
        <field name="name">Turns: own only</field>
        <field name="model_id" ref="model_nli_turn"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
