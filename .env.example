# =============================================================================
# Odoo 18 stack configuration.
# Copy to .env (install.sh does this automatically, and chmods it 600). Empty
# secrets below are generated securely by install.sh on first run.
# NEVER commit .env.
# =============================================================================

# --- Deployment mode (managed by install.sh: dev | prod) ---------------------
DEPLOY_MODE=dev

# Compose project name. Fixed on purpose: it decides which containers and named
# volumes this checkout owns, so moving or renaming the directory keeps working.
COMPOSE_PROJECT_NAME=odoo

# --- Image versions ----------------------------------------------------------
ODOO_IMAGE_TAG=18.0
POSTGRES_VERSION=16
PGADMIN_VERSION=9.16

# --- Odoo source -------------------------------------------------------------
# The stack runs Odoo from ./core (cloned by install.sh, ~1.2 GB shallow).
# Must stay on the same series as ODOO_IMAGE_TAG — the image provides the
# interpreter and every Python dependency the source is run with.
ODOO_SOURCE_REPO=https://github.com/odoo/odoo.git
ODOO_SOURCE_BRANCH=18.0

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=odoo
# Leave empty -> generated by install.sh. Also written to secrets/postgres_password.
POSTGRES_PASSWORD=

# --- Odoo --------------------------------------------------------------------
# Master password for the DB manager (create/backup/restore). Empty -> generated.
ODOO_ADMIN_PASSWD=
# Host-side ports (all bound to 127.0.0.1)
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072
# Prod worker count (rule of thumb: (2 * CPU cores) + 1)
ODOO_WORKERS=4

# --- DEV only ----------------------------------------------------------------
# Host-side Postgres port (exposed on loopback in dev for external DB tools)
DB_PORT=5432
# pgAdmin (dev profile only)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
# Empty -> generated by install.sh. Also written to secrets/pgadmin_password.
PGADMIN_PASSWORD=
