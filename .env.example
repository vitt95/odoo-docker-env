# =============================================================================
# Odoo 18 stack configuration.
# Copy to .env (install.sh does this automatically). Empty secrets below are
# generated securely by install.sh on first run. NEVER commit .env.
# =============================================================================

# --- Deployment mode (managed by install.sh: dev | prod) ---------------------
DEPLOY_MODE=dev

# --- Image versions ----------------------------------------------------------
ODOO_IMAGE_TAG=18.0
POSTGRES_VERSION=16

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=odoo
# Leave empty -> generated by install.sh
POSTGRES_PASSWORD=

# --- Odoo --------------------------------------------------------------------
# Master password for the DB manager (create/backup/restore). Empty -> generated.
ODOO_ADMIN_PASSWD=
# Host-side ports
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072
# Prod worker count (rule of thumb: (2 * CPU cores) + 1)
ODOO_WORKERS=4

# --- DEV only ----------------------------------------------------------------
# Host-side Postgres port (exposed in dev for external DB tools)
DB_PORT=5432
# pgAdmin (dev profile only)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
# Empty -> generated by install.sh
PGADMIN_PASSWORD=

# --- AIDA (parti 5 e 6) ------------------------------------------------------
# Endpoint ammessi verso il fornitore di modello (D77). Vuoto = nessuno.
NLI_ALLOWED_HOSTS=ollama:11434,localhost:11434
# Chiave che sigilla l'enunciato per la sua permanenza in coda (D96).
# Generarla con: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
NLI_UTTERANCE_KEY=
