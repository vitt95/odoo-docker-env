# --- Secrets & generated config (NEVER commit) ---
# NOTE: listing a path here does NOT untrack a file that is already committed.
# config/odoo.conf was tracked until the history purge — verify with
# `git ls-files | grep odoo.conf` before adding anything to this section.
.env
.env.*
!.env.example
/secrets/
config/odoo.conf
*.pem

# --- Odoo source: cloned into ./core, bind-mounted, never tracked (~1.2G) ---
/src
/core

# --- Runtime artifacts ---
/logs/*
!/logs/.gitkeep
/backups/*
!/backups/.gitkeep
/enterprise/*
!/enterprise/.gitkeep
/filestore/

# --- Python ---
__pycache__/
*.pyc
*.pyo
.tokensave
